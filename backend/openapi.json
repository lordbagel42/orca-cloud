{
  "openapi": "3.0.3",
  "info": {
    "title": "Native OrcaSlicer Job API",
    "version": "2.1.0",
    "description": "Slice STL and 3MF models in millimeters using native OrcaSlicer 2.5.0 with full official profile catalog (72 vendors, 14,275 profiles), multi-filament support, preserve_xy placement, and native mesh utilities. Never connects to or operates printers."
  },
  "servers": [{ "url": "https://orca.bagelindustries.com" }],
  "paths": {
    "/healthz": { "get": { "operationId": "health", "summary": "Service health, API version, capabilities and limits", "responses": { "200": { "description": "OK" } } } },
    "/v1/presets": { "get": { "operationId": "listPresets", "summary": "List legacy fixed preset and limits", "responses": { "200": { "description": "OK" } } } },
    "/v2/profiles": { "get": { "operationId": "profiles", "summary": "Search pinned official OrcaSlicer 2.5.0 profiles", "responses": { "200": { "description": "OK" } } } },
    "/v2/profiles/vendors": { "get": { "operationId": "profileVendors", "summary": "List all official profile vendors and counts", "responses": { "200": { "description": "OK" } } } },
    "/v2/profiles/detail": { "get": { "operationId": "profileDetail", "summary": "Read flattened official profile settings and printer bed geometry", "responses": { "200": { "description": "OK" } } } },
    "/v2/settings": { "get": { "operationId": "settings", "summary": "List native OrcaSlicer setting classifications and defaults", "responses": { "200": { "description": "OK" } } } },
    "/v2/profiles/resolve": { "post": { "operationId": "resolveConfiguration", "summary": "Flatten and validate a configuration without persisting it", "responses": { "200": { "description": "OK" }, "422": { "description": "Validation failed" } } } },
    "/v2/configurations": { "post": { "operationId": "createConfiguration", "summary": "Persist an immutable content-addressed configuration handle", "responses": { "201": { "description": "Created" }, "422": { "description": "Validation failed" } } } },
    "/v2/configurations/{id}": {
      "get": { "operationId": "getConfiguration", "summary": "Fetch a retained configuration handle", "responses": { "200": { "description": "OK" }, "404": { "description": "Not found" } } },
      "delete": { "operationId": "deleteConfiguration", "summary": "Delete a retained configuration handle", "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } } }
    },
    "/v1/jobs": {
      "get": { "operationId": "listJobs", "summary": "List retained slicing jobs", "responses": { "200": { "description": "OK" } } },
      "post": { "operationId": "createSliceJob", "summary": "Queue legacy fixed-preset STL slice", "responses": { "202": { "description": "Queued" } } }
    },
    "/v2/jobs": { "post": { "operationId": "createConfiguredJob", "summary": "Queue STL or 3MF slice against a configuration handle", "responses": { "202": { "description": "Queued" } } } },
    "/v1/jobs/{id}": {
      "get": { "operationId": "getSliceJob", "summary": "Read job status, summary, plates and native feedback", "responses": { "200": { "description": "OK" } } },
      "delete": { "operationId": "deleteSliceJob", "summary": "Delete terminal job", "responses": { "204": { "description": "Deleted" } } }
    },
    "/v1/jobs/{id}/gcode": { "get": { "operationId": "downloadGcode", "summary": "Download sliced plate G-code (?plate=N)", "responses": { "200": { "description": "G-code" } } } },
    "/v1/jobs/{id}/3mf": { "get": { "operationId": "download3mf", "summary": "Download sliced 3MF project archive", "responses": { "200": { "description": "3MF" } } } },
    "/v2/mesh/repair": { "post": { "operationId": "repairMesh", "summary": "Run native OrcaSlicer --repair on an STL", "responses": { "200": { "description": "Repaired STL" } } } },
    "/v2/mesh/auto-orient": { "post": { "operationId": "autoOrientMesh", "summary": "Run native OrcaSlicer --orient 1 on an STL", "responses": { "200": { "description": "Oriented STL" } } } },
    "/v2/mesh/inspect": { "post": { "operationId": "inspectMesh", "summary": "Run native OrcaSlicer --inspect-mesh for bounding box and lay-on-face hull", "responses": { "200": { "description": "Mesh JSON" } } } }
  }
}
